<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Full regression suite: runs every test class -->
<suite name="Regression Suite" verbose="1">

    <listeners>
        <listener class-name="com.automation.listeners.TestListener"/>
        <listener class-name="com.automation.listeners.AnnotationTransformer"/>
    </listeners>

    <test name="Shopping App - Regression">
        <classes>
            <class name="com.automation.tests.LoginTest"/>
            <class name="com.automation.tests.CatalogTest"/>
            <class name="com.automation.tests.CartTest"/>
            <class name="com.automation.tests.CheckoutTest"/>
        </classes>
    </test>

</suite>
